# Personal data (user fills these)
cv.md
article-digest.md
NOTES.md
# data/ holds the tracker, scan history, contacts (third-party PII), received
# offers and outcome logs. Ignore the contents, keep the directory scaffolding
# so a fresh clone still has the folders. Matches upstream's pattern.
data/*
!data/.gitkeep
!data/offers/
data/offers/*
!data/offers/.gitkeep
!data/outcomes/
data/outcomes/*
!data/outcomes/.gitkeep
!data/upskill/
data/upskill/*
!data/upskill/.gitkeep
reports/*.md
!reports/.gitkeep
output/*
!output/.gitkeep
batch/logs/*
!batch/logs/.gitkeep
batch/**/*.tsv
!batch/tracker-additions/.gitkeep
jds/*
!jds/.gitkeep

# Writing samples (user's personal files — never committed)
writing-samples/*
!writing-samples/README.md

# User config and customization (never auto-updated)
config/profile.yml
config/cv-facts.json
config/benchmarks.yml
portals.yml
modes/_profile.md
modes/_custom.md
modes/_brief.md
.update-dismissed
.update-lock

# User's personal interview prep files
interview-prep/*.md

# Secrets (never commit — use .env.example as template)
.env

# Generated
.resolved-prompt-*
node_modules/
bun.lock

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json
.claude/memory/
career-dashboard
package-lock.json

# VS Code local
.vscode/*